rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string (optional)
    //   - role: string (required, 'admin' or 'operator')
    //   - createdAt: string (required)
    //
    // Collection: contacts
    // Document ID: {contactId}
    // Fields:
    //   - name: string (required)
    //   - type: string (required, 'B2B' or 'B2C')
    //   - status: string (required, 'Active', 'Inactive', 'Lead')
    //   - ownerId: string (optional)
    //   - ownerName: string (optional)
    //   - lastContactAt: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: jobs
    // Document ID: {jobId}
    // Fields:
    //   - title: string (required)
    //   - contactId: string (optional)
    //   - contactName: string (optional)
    //   - status: string (required)
    //   - assigneeId: string (optional)
    //   - assigneeName: string (optional)
    //   - dueDate: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: invoices
    // Document ID: {invoiceId}
    // Fields:
    //   - contactId: string (optional)
    //   - contactName: string (optional)
    //   - amount: number (required)
    //   - status: string (required)
    //   - issueDate: string (optional)
    //   - dueDate: string (optional)
    //   - createdAt: string (required)
    //
    // Collection: threads
    // Document ID: {threadId}
    // Fields:
    //   - contactId: string (optional)
    //   - contactName: string (optional)
    //   - subject: string (required)
    //   - lastMessageAt: string (optional)
    //   - unread: boolean (optional)
    //   - createdAt: string (required)
    //
    // Collection: threads/{threadId}/messages
    // Document ID: {messageId}
    // Fields:
    //   - threadId: string (required)
    //   - senderId: string (optional)
    //   - senderName: string (optional)
    //   - content: string (required)
    //   - isInternal: boolean (required)
    //   - createdAt: string (required)
    //
    // Collection: approvals
    // Document ID: {approvalId}
    // Fields:
    //   - type: string (required)
    //   - entityName: string (required)
    //   - amount: string (optional)
    //   - requesterId: string (optional)
    //   - requesterName: string (optional)
    //   - status: string (required)
    //   - createdAt: string (required)
    //
    // Collection: files
    // Document ID: {fileId}
    // Fields:
    //   - name: string (required)
    //   - type: string (required)
    //   - size: number (optional)
    //   - ownerId: string (optional)
    //   - ownerName: string (optional)
    //   - createdAt: string (required)
    //   - updatedAt: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner']) ||
        (request.auth.token.email == "caio@astrocleanings.com" && request.auth.token.email_verified == true)
      );
    }

    function isOwner() {
      return isAuthenticated() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner') ||
        (request.auth.token.email == "bailey@astrocleanings.com" && request.auth.token.email_verified == true)
      );
    }

    function isOperatorOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        isOwner() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'operator'
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.role in ['owner', 'admin', 'operator'] &&
             (data.createdAt is string || data.updatedAt is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    hasRequiredFields(['uid', 'email', 'role']) && 
                    isValidUser(request.resource.data) && 
                    ((request.auth.uid == userId && request.resource.data.role == 'operator') || isAdmin() || isOwner());
      allow update: if isAuthenticated() && 
                    isValidUser(request.resource.data) && 
                    ((request.auth.uid == userId && request.resource.data.role == resource.data.role) || isAdmin() || isOwner());
      allow delete: if isOwner();
    }

    match /contacts/{contactId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['name', 'type', 'status', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['title', 'status', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['amount', 'status', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    match /threads/{threadId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['subject', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isOperatorOrAdmin();
        allow create: if isOperatorOrAdmin() && hasRequiredFields(['threadId', 'content', 'isInternal', 'createdAt']);
        allow update: if isOperatorOrAdmin();
        allow delete: if isAdmin();
      }
    }

    match /approvals/{approvalId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['type', 'entityName', 'status', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }

    match /files/{fileId} {
      allow read: if isOperatorOrAdmin();
      allow create: if isOperatorOrAdmin() && hasRequiredFields(['name', 'type', 'createdAt']);
      allow update: if isOperatorOrAdmin();
      allow delete: if isAdmin();
    }
  }
}
